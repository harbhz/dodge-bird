{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "declaration": false,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "helper.ts",
    "code/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
